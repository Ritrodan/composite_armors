Part : <./Data/ships/terran/base_part_terran.rules>/Part
{
	NameKey = "Parts/CompositeC2x1"
	IconNameKey = "Parts/CompositeC2x1Icon"
	ID = Ritrodan.composite_c_2x1
	EditorGroup = "Structure"
	EditorParentParts = [ "Ritrodan.composite_c" ]
	EditorReplacementPartID = Ritrodan.composite_c
	DescriptionKey = "Parts/CompositeC2x1Desc"
	Resources
	[
		[steel, 6]
		[carbon, 2]
	]
	AIValueFactor = 0
	Size = [2, 1]
	FlipHRotate = [0, 1, 2, 3]
	FlipVRotate = [0, 1, 2, 3]
	SelectionTypeID = "armor"
	MaxHealth = 8000
	ExplosiveDamageAbsorption = 100%
	DamageResistances
	{
		explosive = 50%
		thermal = 10%
	}
	TypeCategories = [armor, non_flammable]
	Flammable = false
	InitialPenetrationResistance = 8
	ContinuingPenetrationResistance = &InitialPenetrationResistance
	CreatePartPerTileWhenGrabbed = ""
	CrewSpeedFactor = 0
	Density = 2.6
	IsRotateable = true
	IsWalled = true
	IsSelfDestructible = false
	AllowedDoorLocations = []
	GeneratorRequiresDoor = false
	IgnoreRotationForMirroredSelection = true
	ReceivableBuffs : ^/0/ReceivableBuffs []
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [64, 32]
	}
	Components : ^/0/Components
	{
		EmpAbsorber
		{
			Type = ExplosiveResourceDrainSink
			ResourceType = battery
			AbsorbsResourceDrain = 2000
			RecoveryRate = (&AbsorbsResourceDrain) * 0.1
		}

		Graphics
		{
			Type = Graphics
			Location = [1, 0.5]
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{ File = "armor.png" Size = [2, 1] }
					{ File = "armor_33.png" Size = [2, 1] }
					{ File = "armor_66.png" Size = [2, 1] }
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{ File = "armor.png" Size = [2, 1] }
					{ File = "armor_33.png" Size = [2, 1] }
					{ File = "armor_66.png" Size = [2, 1] }
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{ File = "roof.png" NormalsFile = "roof_normals.png" Size = [2, 1] }
					{ File = "roof_33.png" NormalsFile = "roof_normals_33.png" Size = [2, 1] }
					{ File = "roof_66.png" NormalsFile = "roof_normals_66.png" Size = [2, 1] }
				]
			}
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/SmallPartDestroyedDry
			Location = [1, 0.5]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [2, 1]
		}
	}

	Stats
	{
		EMPResist = (&~/Part/Components/EmpAbsorber/AbsorbsResourceDrain) / 1000
		AOEResist = (&~/Part/DamageResistances/explosive) * 100
	}
}
