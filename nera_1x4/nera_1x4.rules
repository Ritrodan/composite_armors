Part : <./Data/ships/terran/base_part_terran.rules>/Part
{
	NameKey = "Parts/NERA1x4"
	IconNameKey = "Parts/NERA1x4Icon"
	ID = Ritrodan.nera_1x4
	EditorGroup = "Structure"
	EditorParentParts = [ "Ritrodan.nera" ]
	EditorReplacementPartID = nera
	DescriptionKey = "Parts/NERA1x4Desc"
	Resources
	[
		[steel, 8]
		[coil, 4]
	]
	AIValueFactor = 0
	Size = [1, 4]
	FlipHRotate = [0, 1, 2, 3]
	FlipVRotate = [0, 1, 2, 3]
	SelectionTypeID = "armor"
	MaxHealth = 9600
	ExplosiveDamageAbsorption = 50%
	DamageResistances
	{
		explosive = 50%
		thermal = -25%
	}
	TypeCategories = [armor, non_flammable]
	Flammable = false
	InitialPenetrationResistance = 6
	ContinuingPenetrationResistance = &InitialPenetrationResistance
	CreatePartPerTileWhenGrabbed = ""
	CrewSpeedFactor = 0
	Density = 1.2
	IsRotateable = true
	IsWalled = true
	IsSelfDestructible = false
	AllowedDoorLocations = []
	GeneratorRequiresDoor = false
	IgnoreRotationForMirroredSelection = true
	ReceivableBuffs : ^/0/ReceivableBuffs []
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [32, 128]
	}
	Components : ^/0/Components
	{
		EmpAbsorber
		{
			Type = ExplosiveResourceDrainSink
			ResourceType = battery
			AbsorbsResourceDrain = 4000
			RecoveryRate = (&AbsorbsResourceDrain) * 0.1
		}

		Graphics
		{
			Type = Graphics
			Location = [0.5, 2]
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{ File = "armor.png" Size = [1, 4] }
					{ File = "armor_33.png" Size = [1, 4] }
					{ File = "armor_66.png" Size = [1, 4] }
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{ File = "armor.png" Size = [1, 4] }
					{ File = "armor_33.png" Size = [1, 4] }
					{ File = "armor_66.png" Size = [1, 4] }
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{ File = "roof2.png" NormalsFile = "roof_normals.png" Size = [1, 4] }
					{ File = "roof_33.png" NormalsFile = "roof_normals_33.png" Size = [1, 4] }
					{ File = "roof_66.png" NormalsFile = "roof_normals_66.png" Size = [1, 4] }
				]
			}
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/SmallPartDestroyedDry
			Location = [0.5, 2]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [1, 4]
		}
	}

	Stats
	{
		EMPResist = (&~/Part/Components/EmpAbsorber/AbsorbsResourceDrain) / 1000
		AOEResist = (&~/Part/DamageResistances/explosive) * 100
	}
}
