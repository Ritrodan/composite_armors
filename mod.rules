ID = Ritrodan.composite_armor // Replace "yourname" with your own author handle. Must not be "cosmoteer".
Name = "Composite Armors"
Version = 1.0.0
CompatibleGameVersions = ["0.30.1"] // Set this to your installed game version (shown on the title screen).
Author = "Ritrodan"
Description = "Adds three new armor types for testing: NERA, Face-Hardened Armor, and Depleted Uranium Armor."
ModifiesMultiplayer = true
ModifiesGameplay = true
StringsFolder = "strings"

Actions
[
	{
		Action = AddMany
		AddTo = "<ships/terran/terran.rules>/Terran/Parts"
		ManyToAdd
		[
			&<nera/nera.rules>/Part
			&<face_hardened/face_hardened.rules>/Part
			&<depleted_uranium/depleted_uranium.rules>/Part
		]
	}
]
