ID = Ritrodan.composite_armor
Name = "Composite Armors"
Version = 1.0.0
CompatibleGameVersions = ["0.30.1"]
Author = "Ritrodan"
Description = "Adds new armor types: NERA, Tri-Steel Armor, Combination C, Metal Foam, Composite Metal Foam, Gold Plating, and Depleted Uranium, with multiple size and wedge variants."
ModifiesMultiplayer = true
ModifiesGameplay = true
StringsFolder = "strings"

Actions
[
	{
		Action = AddMany
		AddTo = "<ships/terran/terran.rules>/Terran/Parts"
		ManyToAdd
		[
			&<nera/1x1/nera.rules>/Part
			&<nera/2x1/nera_2x1.rules>/Part
			&<nera/3x1/nera_3x1.rules>/Part
			&<nera/4x1/nera_4x1.rules>/Part
			&<nera/2x2/nera_2x2.rules>/Part
			&<nera/wedge/nera_Wedge.rules>/Part
			&<nera/1x2_wedge/nera_1x2Wedge.rules>/Part
			&<nera/1x3_wedge/nera_1x3Wedge.rules>/Part
			&<tri_steel/1x1/tri_steel.rules>/Part
			&<tri_steel/2x1/tri_steel_2x1.rules>/Part
			&<tri_steel/wedge/tri_steel_Wedge.rules>/Part
			&<tri_steel/1x2_wedge/tri_steel_1x2Wedge.rules>/Part
			&<tri_steel/1x3_wedge/tri_steel_1x3Wedge.rules>/Part
			&<combination_c/1x1/combination_c.rules>/Part
			&<combination_c/2x1/combination_c_2x1.rules>/Part
			&<combination_c/wedge/combination_c_Wedge.rules>/Part
			&<combination_c/1x2_wedge/combination_c_1x2Wedge.rules>/Part
			&<combination_c/1x3_wedge/combination_c_1x3Wedge.rules>/Part
			&<metal_foam/1x1/metal_foam.rules>/Part
			&<metal_foam/2x1/metal_foam_2x1.rules>/Part
			&<metal_foam/wedge/metal_foam_Wedge.rules>/Part
			&<metal_foam/1x2_wedge/metal_foam_1x2Wedge.rules>/Part
			&<metal_foam/1x3_wedge/metal_foam_1x3Wedge.rules>/Part
			&<composite_metal_foam/1x1/composite_metal_foam.rules>/Part
			&<composite_metal_foam/2x1/composite_metal_foam_2x1.rules>/Part
			&<composite_metal_foam/wedge/composite_metal_foam_Wedge.rules>/Part
			&<composite_metal_foam/1x2_wedge/composite_metal_foam_1x2Wedge.rules>/Part
			&<composite_metal_foam/1x3_wedge/composite_metal_foam_1x3Wedge.rules>/Part
			&<ferroconcrete/1x1/ferroconcrete.rules>/Part
			&<ferroconcrete/2x1/ferroconcrete_2x1.rules>/Part
			&<ferroconcrete/wedge/ferroconcrete_Wedge.rules>/Part
			&<ferroconcrete/1x2_wedge/ferroconcrete_1x2Wedge.rules>/Part
			&<ferroconcrete/1x3_wedge/ferroconcrete_1x3Wedge.rules>/Part
			&<gold_shielding/1x1/gold_shielding.rules>/Part
			&<gold_shielding/2x1/gold_shielding_2x1.rules>/Part
			&<uranium/1x1/uranium.rules>/Part
			&<uranium/2x1/uranium_2x1.rules>/Part
			&<uranium/wedge/uranium_Wedge.rules>/Part
			&<uranium/1x2_wedge/uranium_1x2Wedge.rules>/Part
			&<uranium/1x3_wedge/uranium_1x3Wedge.rules>/Part
		]
	}
]
